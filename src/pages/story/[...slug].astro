---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import StoryCard from '../../components/StoryCard.astro';
import StoryCover from '../../components/StoryCover.astro';
import { getCollection, render } from 'astro:content';
import { categoryToSlug } from '../../utils/categories';

export async function getStaticPaths() {
  const stories = await getCollection('stories', ({ data }) => !data.draft);
  return stories.map(story => ({
    params: { slug: story.id },
    props: { story }
  }));
}

const { story } = Astro.props;
const { Content } = await render(story);

const formattedPubDate = new Date(story.data.pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const categorySlug = categoryToSlug(story.data.category);

// Compute Related Cases (same category prioritized, then tag overlap, up to 3)
const allStories = await getCollection('stories', ({ data }) => !data.draft);
const relatedStories = allStories
  .filter(s => s.id !== story.id)
  .sort((a, b) => {
    const aSameCat = a.data.category === story.data.category ? 3 : 0;
    const bSameCat = b.data.category === story.data.category ? 3 : 0;

    const aSharedTags = a.data.tags ? a.data.tags.filter(t => story.data.tags?.includes(t)).length : 0;
    const bSharedTags = b.data.tags ? b.data.tags.filter(t => story.data.tags?.includes(t)).length : 0;

    return (bSameCat + bSharedTags) - (aSameCat + aSharedTags);
  })
  .slice(0, 3);

const breadcrumbs = [
  { name: 'Archive', url: '/' },
  { name: story.data.category, url: `/category/${categorySlug}` },
  { name: story.data.title, url: `/story/${story.id}` }
];

// Shortened clean title tag pattern for SEO (<60-75 chars)
const pageTitle = `${story.data.title} | Night Lore`;

// Particle animation configurations for 10 hero background embers
const emberConfigs = [
  { left: '6%', size: '3px', duration: '42s', delay: '-14s', drift: '25px', opacity: '0.15' },
  { left: '20%', size: '2px', duration: '56s', delay: '-35s', drift: '-18px', opacity: '0.12' },
  { left: '33%', size: '4px', duration: '38s', delay: '-8s', drift: '30px', opacity: '0.18' },
  { left: '46%', size: '2.5px', duration: '48s', delay: '-22s', drift: '-25px', opacity: '0.14' },
  { left: '58%', size: '3px', duration: '34s', delay: '-5s', drift: '20px', opacity: '0.16' },
  { left: '70%', size: '2px', duration: '60s', delay: '-41s', drift: '-15px', opacity: '0.12' },
  { left: '82%', size: '4px', duration: '44s', delay: '-18s', drift: '35px', opacity: '0.19' },
  { left: '94%', size: '3px', duration: '52s', delay: '-29s', drift: '-20px', opacity: '0.15' },
  { left: '14%', size: '3.5px', duration: '36s', delay: '-27s', drift: '18px', opacity: '0.17' },
  { left: '66%', size: '2.5px', duration: '50s', delay: '-12s', drift: '-30px', opacity: '0.13' }
];
---

<Layout
  title={pageTitle}
  description={story.data.dek}
  articleMeta={{
    publishedTime: story.data.pubDate.toISOString(),
    updatedTime: story.data.updatedDate ? story.data.updatedDate.toISOString() : story.data.pubDate.toISOString(),
    category: story.data.category,
    tags: story.data.tags || []
  }}
  breadcrumbs={breadcrumbs}
>
  <article class="max-w-4xl mx-auto">
    <!-- Back Navigation -->
    <a
      href={`/category/${categorySlug}`}
      onclick={`if (document.referrer && window.history.length > 1) { try { if (new URL(document.referrer).origin === window.location.origin) { event.preventDefault(); window.history.back(); } } catch (e) {} }`}
      class="inline-flex items-center gap-1.5 text-xs font-mono-meta text-[var(--color-text-dim)] hover:text-[var(--glow)] transition-colors mb-4"
    >
      ← Back to {story.data.category}
    </a>

    <!-- Navigation Breadcrumbs -->
    <div class="flex items-center gap-2 text-xs font-mono-meta text-[var(--color-text-dim)] mb-6 flex-wrap">
      <a href="/" class="hover:text-[var(--glow)]">ARCHIVE</a>
      <span>/</span>
      <a href={`/category/${categorySlug}`} class="hover:text-[var(--glow)]">
        {story.data.category.toUpperCase()}
      </a>
      <span>/</span>
      <span class="text-[var(--color-text-muted)] truncate max-w-[180px] sm:max-w-[300px]">{story.id}</span>
    </div>

    <!-- Article Header / Hero Section -->
    <header class="relative mb-10 pb-8 border-b border-[var(--color-border)] overflow-hidden">
      <!-- Background Ambient Pulse & Drifting Embers (Hero Only) -->
      <div class="story-hero-bg-container" aria-hidden="true">
        <div class="story-ambient-glow"></div>
        {emberConfigs.map((cfg) => (
          <span
            class="ember-particle"
            style={`--x-pos: ${cfg.left}; --size: ${cfg.size}; --duration: ${cfg.duration}; --delay: ${cfg.delay}; --drift-x: ${cfg.drift}; --base-opacity: ${cfg.opacity};`}
          />
        ))}
      </div>

      <!-- Hero Content -->
      <div class="relative z-10">
        <div class="flex items-center gap-3 mb-4 flex-wrap">
          <StatusBadge status={story.data.status} />
          <span class="font-mono-meta text-xs text-[var(--color-text-dim)]">
            DOSSIER ID: NL-{story.id.toUpperCase()}
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4 leading-tight">
          {story.data.title}
        </h1>

        <p class="text-lg sm:text-xl text-[var(--color-text-muted)] leading-relaxed mb-6 font-normal">
          {story.data.dek}
        </p>

        <!-- Metadata Box -->
        <div class="nl-card p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono-meta text-xs text-[var(--color-text-dim)]">
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[var(--glow)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>{story.data.location}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-[var(--color-text-dim)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Event: {story.data.eventDate}</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span>Published: {formattedPubDate}</span>
            </div>
          </div>

          {story.data.audioUrl && (
            <button
              onclick={`window.dispatchEvent(new CustomEvent('nl:play-audio', { detail: { url: '${story.data.audioUrl}', title: '${story.data.title.replace(/'/g, "\\'")}' } }))`}
              class="btn-primary text-xs py-2 px-3 gap-1.5 w-full sm:w-auto justify-center flex-shrink-0"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
              Play Narration ({story.data.audioDuration || 'Audio'})
            </button>
          )}
        </div>
      </div>
    </header>

    <!-- Hero Cover Image & Visible Attribution -->
    {story.data.coverImage && (
      <StoryCover
        src={story.data.coverImage}
        alt={story.data.coverAlt || story.data.title}
        credit={story.data.coverCredit}
        creditUrl={story.data.coverCreditUrl}
        license={story.data.coverLicense}
      />
    )}

    <!-- Main Article Body -->
    <div class="prose-dark max-w-none leading-relaxed mb-12">
      <Content />
    </div>

    <!-- Sources & Bibliography Section -->
    {story.data.sources && story.data.sources.length > 0 && (
      <section class="nl-card p-6 sm:p-8 mb-12 border-l-2 border-l-[var(--glow)]">
        <h3 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-4">
          // ARCHIVAL SOURCES & BIBLIOGRAPHY
        </h3>
        <ul class="space-y-3 font-mono-meta text-xs">
          {story.data.sources.map(source => (
            <li class="flex items-start gap-2">
              <svg class="w-3.5 h-3.5 text-[var(--glow)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 005.656-5.656l-1.1 1.1"/></svg>
              <a
                href={source.url}
                target="_blank"
                rel="nofollow noopener noreferrer"
                class="text-[var(--color-text-muted)] hover:text-[var(--glow)] transition-colors underline underline-offset-4 break-all sm:break-normal"
              >
                {source.label}
              </a>
            </li>
          ))}
        </ul>
        <p class="text-xs text-[var(--color-text-dim)] mt-4">
          Note: Outbound links direct to public domain historical archives, legal filings, and official government FOIA documents. Story audio narration synthesized via Google Gemini 3.1 Flash TTS.
        </p>
      </section>
    )}

    <!-- Tags -->
    {story.data.tags && (
      <div class="flex items-center gap-2 flex-wrap mb-12 font-mono-meta text-xs">
        <span class="text-[var(--color-text-dim)]">TAGS:</span>
        {story.data.tags.map(tag => (
          <span class="px-2 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)]">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Related Cases Internal Linking Section -->
    {relatedStories.length > 0 && (
      <section class="mb-12 pt-8 border-t border-[var(--color-border)]">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xs font-mono-meta uppercase tracking-wider text-[var(--color-text-dim)]">
            // RELATED CASE DOSSIERS
          </h2>
          <a href={`/category/${categorySlug}`} class="text-xs font-mono-meta text-[var(--glow)] hover:underline">
            View All in {story.data.category} →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedStories.map(relStory => (
            <StoryCard
              title={relStory.data.title}
              dek={relStory.data.dek}
              slug={relStory.id}
              category={relStory.data.category}
              status={relStory.data.status}
              location={relStory.data.location}
              eventDate={relStory.data.eventDate}
              pubDate={relStory.data.pubDate}
              audioDuration={relStory.data.audioDuration}
              coverImage={relStory.data.coverImage}
              coverAlt={relStory.data.coverAlt}
            />
          ))}
        </div>
      </section>
    )}

    <!-- Similar Encounter Prompt -->
    <div class="nl-card p-6 sm:p-8 text-center bg-[var(--color-surface-2)] border-[var(--color-border)]">
      <h3 class="text-xl font-bold text-[var(--color-text)] mb-2">
        Have Information or a Similar Experience?
      </h3>
      <p class="text-sm text-[var(--color-text-muted)] mb-6 max-w-lg mx-auto leading-relaxed">
        Our research team reviews first-person accounts, localized folklore, and secondary evidence related to {story.data.location}.
      </p>
      <a href="/submit" class="btn-primary text-xs">
        Submit Your Encounter For Review
      </a>
    </div>
  </article>
</Layout>
