---
import Layout from '../layouts/Layout.astro';
import BackButton from '../components/BackButton.astro';

interface Props {
  error: unknown;
}

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : (typeof error === 'string' ? error : null);
---

<Layout
  title="500 — Edge Telemetry Failure | Night Lore Archive"
  description="An unexpected server error occurred while retrieving this case file."
  noindex={true}
>
  <div class="max-w-3xl mx-auto py-6 sm:py-12">
    <div class="mb-6 flex items-center justify-start">
      <BackButton fallbackHref="/" label="Back" />
    </div>

    <div class="text-center">
      <!-- Status Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-[var(--color-surface)] border border-[rgba(255,107,74,0.4)] text-[var(--glow)] font-mono-meta text-xs tracking-widest uppercase mb-6 shadow-md">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
      STATUS: 500 // SERVER DISRUPTION
    </div>

    <!-- Error Code Large Display -->
    <h1 class="text-7xl sm:text-9xl font-extrabold tracking-tighter text-[var(--color-text)] mb-4 font-mono-meta opacity-90 select-none">
      500
    </h1>

    <!-- Headline & Narrative Copy -->
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-4">
      Edge Telemetry Anomaly
    </h2>

    <p class="text-sm sm:text-base text-[var(--color-text-muted)] max-w-lg mx-auto leading-relaxed mb-6">
      An unexpected server-side error occurred while rendering this request. The disturbance has been logged to our edge server diagnostics.
    </p>

    <!-- Safe Sanitized Error Notice (if available) -->
    {errorMessage && (
      <div class="max-w-lg mx-auto mb-8 p-4 rounded bg-black/50 border border-[var(--color-border)] font-mono-meta text-xs text-[var(--status-unresolved)] text-left">
        <span class="text-[var(--color-text-dim)]">// ERROR DIAGNOSTIC:</span> {errorMessage}
      </div>
    )}

    <!-- Navigation & Recovery Actions -->
    <div class="nl-card p-6 sm:p-8 bg-[var(--color-surface-2)] text-left mb-8 max-w-lg mx-auto">
      <h3 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-3">
        // RECOVERY INSTRUCTIONS
      </h3>
      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4">
        If this error persists, you can return to the main archive or reach out to our editorial desk directly.
      </p>
      <div class="space-y-2 text-xs font-mono-meta">
        <a href="/" class="block text-[var(--glow)] hover:underline">
          → Return to Archive Home
        </a>
        <a href="/submit" class="block text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
          → Submit Encounter / Report Case Issue
        </a>
        <a href="/contact" class="block text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
          → Contact Editorial Desk (contact@mynightlore.com)
        </a>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-center gap-4 flex-wrap">
      <a href="/" class="btn-primary text-xs px-6 py-2.5">
        ← Return to Archive Home
      </a>
      <a href="/contact" class="inline-flex items-center justify-center px-4 py-2.5 text-xs font-mono-meta border border-[var(--color-border)] rounded-md text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:border-[var(--glow)] transition-colors">
        Contact Editorial Desk
      </a>
    </div>
  </div>
</div>
</Layout>
