---
import Layout from '../../layouts/Layout.astro';
import StoryCard from '../../components/StoryCard.astro';
import BackButton from '../../components/BackButton.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type CategoryInfo } from '../../utils/categories';

export async function getStaticPaths() {
  return Object.values(CATEGORIES).map(cat => ({
    params: { category: cat.slug },
    props: { categoryData: cat }
  }));
}

interface Props {
  categoryData: CategoryInfo;
}

const { categoryData } = Astro.props;
const allStories = await getCollection('stories', ({ data }) => !data.draft);
const categoryStories = allStories
  .filter(s => s.data.category === categoryData.name)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const breadcrumbs = [
  { name: 'Archive', url: '/' },
  { name: categoryData.name, url: `/category/${categoryData.slug}` }
];
---

<Layout
  title={categoryData.title}
  description={categoryData.description}
  breadcrumbs={breadcrumbs}
>
  <div class="mb-12 border-b border-[var(--color-border)] pb-8 pt-4">
    <div class="flex items-center justify-between gap-4 mb-4 flex-wrap font-mono-meta text-xs">
      <BackButton fallbackHref="/" label="Back to Archive" />

      <div class="flex items-center gap-4 flex-wrap">
        <div class="flex items-center gap-2 text-[var(--color-text-dim)]">
          <a href="/" class="hover:text-[var(--glow)]">ARCHIVE</a>
          <span>/</span>
          <span class="text-[var(--glow)] font-semibold">{categoryData.name.toUpperCase()}</span>
        </div>

        <div class="px-2.5 py-1 rounded bg-[var(--color-surface)] border border-[var(--color-border)] text-[var(--color-text-dim)]">
          INDEX REPOSITORY // {categoryStories.length} {categoryStories.length === 1 ? 'RECORD' : 'RECORDS'}
        </div>
      </div>
    </div>

    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[var(--color-text)] mb-4">
      {categoryData.name}
    </h1>

    <p class="text-base text-[var(--color-text-muted)] max-w-3xl leading-relaxed">
      {categoryData.introCopy}
    </p>
  </div>

  {categoryStories.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categoryStories.map(story => (
        <StoryCard
          title={story.data.title}
          dek={story.data.dek}
          slug={story.id}
          category={story.data.category}
          status={story.data.status}
          location={story.data.location}
          eventDate={story.data.eventDate}
          pubDate={story.data.pubDate}
          audioDuration={story.data.audioDuration}
          coverImage={story.data.coverImage}
          coverAlt={story.data.coverAlt}
        />
      ))}
    </div>
  ) : (
    <div class="nl-card p-12 text-center my-12 bg-[var(--color-surface)] border-[var(--color-border)]">
      <p class="text-base text-[var(--color-text-muted)] mb-4">
        No case files are currently published under this category.
      </p>
      <a href="/" class="btn-primary text-xs py-2 px-4">
        Return to Archive Index
      </a>
    </div>
  )}
</Layout>

