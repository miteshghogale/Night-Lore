---
import Layout from '../../layouts/Layout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import BackButton from '../../components/BackButton.astro';
import { env } from 'cloudflare:workers';

export const prerender = false;

interface SubmissionRow {
  id: string;
  title: string;
  category: string;
  location: string;
  event_date: string;
  story_text: string;
  author_name: string;
  is_anonymous: number;
  email: string;
  status: 'pending' | 'approved' | 'rejected';
  created_at: string;
}

let submissions: SubmissionRow[] = [];
let dbError: string | null = null;

try {
  const db = (env as any)?.DB;
  if (db) {
    const res = await db.prepare(`SELECT * FROM submissions ORDER BY created_at DESC`).all();
    submissions = (res.results || []) as SubmissionRow[];
  } else {
    // Mock local data if DB binding unconfigured
    submissions = [
      {
        id: 'SUB-MOCK-001',
        title: 'Unexplained Nocturnal Knocking on Red River Farm',
        category: 'Country Stories',
        location: 'Adams, Tennessee',
        event_date: 'Fall 2023',
        story_text: 'I woke up to three distinct, loud knocks against my bedroom window at 3:15 AM every night for a week. There are no trees near the window and no footsteps on the soft mud outside. Our farm dogs refuse to enter that side of the house.',
        author_name: 'M. Adams',
        is_anonymous: 0,
        email: 'm.adams@example.com',
        status: 'pending',
        created_at: new Date().toISOString()
      }
    ];
  }
} catch (err: any) {
  dbError = err?.message || 'Error fetching submissions from Cloudflare D1.';
}

const pendingList = submissions.filter(s => s.status === 'pending');
const historyList = submissions.filter(s => s.status !== 'pending');
---

<Layout title="Editorial Moderation Dashboard | Night Lore Admin">
  <div class="max-w-5xl mx-auto px-2 sm:px-4">
    <!-- Top Back Button -->
    <div class="mb-4">
      <BackButton fallbackHref="/" label="Back to Archive" />
    </div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-[var(--color-border)] pb-6 mb-8 gap-4">
      <div>
        <div class="flex items-center gap-2 text-xs font-mono-meta text-[var(--color-text-dim)] mb-2">
          <span>PORTAL</span>
          <span>/</span>
          <span class="text-[var(--glow)]">MODERATION QUEUE</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-[var(--color-text)]">
          Reader Submissions Moderation
        </h1>
      </div>

      <div class="flex items-center gap-3 font-mono-meta text-xs">
        <span class="px-3 py-1.5 rounded border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)]">
          PENDING: <strong class="text-[var(--status-unresolved)]">{pendingList.length}</strong>
        </span>
        <span class="px-3 py-1.5 rounded border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)]">
          PROCESSED: <strong class="text-[var(--color-text)]">{historyList.length}</strong>
        </span>
      </div>
    </div>

    <!-- Explanatory Publishing Scope Banner -->
    <div class="nl-card p-4 sm:p-5 mb-8 border-l-2 border-l-[var(--glow)] bg-[var(--color-surface-2)]">
      <div class="flex items-start gap-3">
        <svg class="w-4 h-4 text-[var(--glow)] flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <div class="text-xs text-[var(--color-text-muted)] leading-relaxed">
          <strong class="text-[var(--color-text)] block mb-1">Editorial Workflow Notice:</strong>
          Approving a submission updates its status in the D1 database to <code class="text-[var(--status-witnessed)] font-mono-meta">approved</code>. To publish an approved story as a live article on the website, create a corresponding Markdown file in <code class="font-mono-meta text-[var(--color-text)]">src/content/stories/</code> per the existing content collection workflow.
        </div>
      </div>
    </div>

    {dbError && (
      <div class="p-4 rounded border border-[var(--status-debunked)] bg-[var(--color-surface)] text-[var(--status-debunked)] font-mono-meta text-xs mb-8 flex items-center gap-2">
        <svg class="w-4 h-4 text-[var(--status-debunked)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        <span>DATABASE ERROR: {dbError}</span>
      </div>
    )}

    <!-- Pending Queue Section -->
    <section class="mb-12">
      <h2 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-6">
        // PENDING REVIEW QUEUE ({pendingList.length})
      </h2>

      {pendingList.length > 0 ? (
        <div class="space-y-6" id="pending-container">
          {pendingList.map(item => (
            <article
              id={`card-${item.id}`}
              class="nl-card p-4 sm:p-6 border-[var(--color-border)] relative space-y-4"
            >
              <!-- Card Header -->
              <div class="flex items-center justify-between gap-3 flex-wrap border-b border-[var(--color-border)] pb-3">
                <div class="flex items-center gap-3">
                  <span class="status-stamp status-stamp-unresolved">PENDING</span>
                  <span class="font-mono-meta text-xs text-[var(--color-text-dim)]">{item.category}</span>
                </div>
                <span class="font-mono-meta text-xs text-[var(--color-text-dim)]">{item.id}</span>
              </div>

              <!-- Title -->
              <h3 class="text-lg sm:text-xl font-bold text-[var(--color-text)] tracking-tight">
                {item.title}
              </h3>

              <!-- Metadata Row -->
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-mono-meta text-[var(--color-text-dim)]">
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-[var(--glow)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  Location: <strong class="text-[var(--color-text-muted)]">{item.location}</strong>
                </span>
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  Event Date: <strong class="text-[var(--color-text-muted)]">{item.event_date || 'Unknown'}</strong>
                </span>
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  Author: <strong class="text-[var(--color-text-muted)]">{item.is_anonymous ? 'Anonymous' : item.author_name}</strong>
                </span>
                <span class="inline-flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-[var(--color-text-dim)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Submitted: {new Date(item.created_at).toLocaleDateString('en-US')}
                </span>
              </div>

              <!-- Full Story Text -->
              <div class="bg-[var(--color-bg)] p-4 rounded border border-[var(--color-border)] text-xs sm:text-sm text-[var(--color-text-muted)] leading-relaxed whitespace-pre-wrap font-sans max-h-96 overflow-y-auto">
                {item.story_text}
              </div>

              <!-- Confidential Email Mask & Action Buttons -->
              <div class="pt-3 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-[var(--color-border)]">
                <!-- Privacy-Protected Email Toggle -->
                <div class="flex items-center gap-2 text-xs font-mono-meta flex-wrap">
                  <span class="text-[var(--color-text-dim)]">Email:</span>
                  <span id={`email-masked-${item.id}`} class="text-[var(--color-text-dim)] font-mono">••••••••@••••.com</span>
                  <span id={`email-real-${item.id}`} class="hidden text-[var(--glow)] font-mono break-all">{item.email}</span>
                  <button
                    type="button"
                    onclick={`document.getElementById('email-masked-${item.id}').classList.toggle('hidden'); document.getElementById('email-real-${item.id}').classList.toggle('hidden');`}
                    class="inline-flex items-center gap-1 ml-1 text-[10px] uppercase text-[var(--color-text-muted)] hover:text-[var(--color-text)] underline cursor-pointer p-1"
                  >
                    <svg class="w-3 h-3 text-[var(--glow)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                    Toggle Email
                  </button>
                </div>

                <!-- Approve & Reject Actions -->
                <div class="flex items-center gap-3 w-full sm:w-auto">
                  <button
                    type="button"
                    onclick={`handleAdminAction('${item.id}', 'reject')`}
                    class="flex-1 sm:flex-initial min-h-[40px] px-5 py-2.5 rounded text-xs font-mono-meta border border-[var(--status-debunked)] text-[var(--status-debunked)] hover:bg-[var(--status-debunked)]/10 transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                    Reject
                  </button>
                  <button
                    type="button"
                    onclick={`handleAdminAction('${item.id}', 'approve')`}
                    class="flex-1 sm:flex-initial min-h-[40px] px-5 py-2.5 rounded text-xs font-mono-meta border border-[var(--status-witnessed)] text-[var(--status-witnessed)] bg-[var(--status-witnessed)]/10 hover:bg-[var(--status-witnessed)]/20 transition-colors cursor-pointer inline-flex items-center justify-center gap-1.5"
                  >
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    Approve
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="nl-card p-8 text-center text-xs font-mono-meta text-[var(--color-text-dim)] flex items-center justify-center gap-2">
          <svg class="w-4 h-4 text-[var(--status-witnessed)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span>NO PENDING SUBMISSIONS IN QUEUE</span>
        </div>
      )}
    </section>

    <!-- Collapsible History Section -->
    <section class="mb-12">
      <details class="nl-card p-6 group">
        <summary class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] cursor-pointer list-none flex items-center justify-between">
          <span>// PROCESSED HISTORY ({historyList.length})</span>
          <span class="text-[var(--glow)] font-mono-meta text-[10px] inline-flex items-center gap-1">
            EXPAND
            <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </span>
        </summary>

        <div class="mt-6 space-y-4 pt-4 border-t border-[var(--color-border)]">
          {historyList.length > 0 ? (
            historyList.map(item => (
              <div class="p-4 rounded border border-[var(--color-border)] bg-[var(--color-bg)] flex items-center justify-between gap-4 flex-wrap text-xs font-mono-meta">
                <div class="flex items-center gap-3">
                  <StatusBadge status={item.status === 'approved' ? 'witnessed' : 'debunked'} />
                  <span class="text-[var(--color-text)] font-semibold font-sans text-sm">{item.title}</span>
                </div>
                <div class="flex items-center gap-4 text-[var(--color-text-dim)]">
                  <span>{item.category}</span>
                  <span>{item.id}</span>
                </div>
              </div>
            ))
          ) : (
            <p class="text-xs font-mono-meta text-[var(--color-text-dim)] text-center py-4">
              No historical records found.
            </p>
          )}
        </div>
      </details>
    </section>
  </div>
</Layout>

<script is:inline>
  async function handleAdminAction(id, action) {
    const card = document.getElementById(`card-${id}`);
    if (!card) return;

    try {
      const res = await fetch('/api/admin-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, action })
      });

      const data = await res.json();

      if (data.success) {
        // Remove card smoothly from DOM
        card.style.opacity = '0.4';
        card.style.pointerEvents = 'none';
        setTimeout(() => {
          card.remove();
          // Reload page if no cards left to refresh counters
          const remaining = document.querySelectorAll('#pending-container article');
          if (remaining.length === 0) {
            window.location.reload();
          }
        }, 300);
      } else {
        alert(`Error performing action: ${data.error || 'Unknown error'}`);
      }
    } catch (err) {
      alert('Network error communicating with admin API.');
    }
  }
</script>
