---
import Layout from '../layouts/Layout.astro';
import BackButton from '../components/BackButton.astro';
---

<!-- 
  NOTE FOR SITE OWNER:
  This Privacy Policy is a baseline disclosure template designed to meet standard Google AdSense,
  GDPR (EU/UK), CCPA/CPRA (California), and Cloudflare Pages hosting requirements.
  It does not constitute formal legal counsel. Professional legal review is recommended prior
  to scaling commercial ad operations.
-->

<Layout
  title="Privacy Policy & Data Protection Disclosures | Night Lore"
  description="Official Privacy Policy for Night Lore detailing Google AdSense disclosures, cookie usage, analytics, reader submission data handling, GDPR data subject rights, and CCPA rights."
>
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-10 border-b border-[var(--color-border)] pb-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 mb-4 font-mono-meta text-xs">
        <BackButton fallbackHref="/" label="Back" />
        <div class="flex items-center gap-2 text-[var(--color-text-dim)]">
          <a href="/" class="hover:text-[var(--glow)] transition-colors">ARCHIVE</a>
          <span>/</span>
          <span class="text-[var(--glow)]">PRIVACY POLICY</span>
        </div>
      </div>

      <h1 class="text-2xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4 break-words">
        Privacy Policy
      </h1>

      <p class="text-xs font-mono-meta text-[var(--color-text-dim)] mb-2">
        LAST UPDATED: AUGUST 2026 // EFFECTIVE IMMEDIATELY
      </p>

      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        Night Lore (<code class="text-[var(--glow)] font-mono-meta text-xs">mynightlore.com</code>) values transparency and respects reader privacy. This document details how information is collected, processed, and protected across our digital archive and serverless edge hosting infrastructure.
      </p>
    </div>

    <!-- Section 1: Overview & Scope -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 1.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Overview & Edge Infrastructure
        </h2>
      </div>
      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        Night Lore is built as a static site hosted globally via Cloudflare Pages. Browsing our published dossiers and listening to synthesized audio narrations does not require account creation, registration, or submission of personal identity information.
      </p>
    </section>

    <!-- Section 2: Advertising & Third-Party Cookies (AdSense Mandatory Disclosure) -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 2.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Google AdSense & Third-Party Advertising Cookies
        </h2>
      </div>

      <div class="nl-card p-6 space-y-4 text-sm text-[var(--color-text-muted)] leading-relaxed mb-4 bg-[var(--color-surface-2)] border-l-2 border-l-[var(--glow)]">
        <p>
          Night Lore uses third-party advertising vendors, including <strong>Google AdSense</strong>, to serve advertisements when you visit our website.
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong>Ad Personalization & Cookies:</strong> Third-party vendors, including Google, use cookies to serve ads based on a user's prior visits to Night Lore or other websites on the Internet.
          </li>
          <li>
            <strong>Advertising Network Cookies:</strong> Google's use of advertising cookies enables it and its advertising partners to serve ads to users based on their visit to our site and/or other sites across the web.
          </li>
          <li>
            <strong>Opting Out:</strong> Users may opt out of personalized advertising by visiting <a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-[var(--glow)] underline">Google Ad Settings</a>. Alternatively, users can opt out of third-party vendor cookies for personalized advertising by visiting <a href="https://www.aboutads.info" target="_blank" rel="noopener noreferrer" class="text-[var(--glow)] underline">www.aboutads.info</a>.
          </li>
        </ul>
      </div>

      <p class="text-xs text-[var(--color-text-muted)] leading-relaxed">
        For complete details on how Google handles data collected from partner websites, please review Google’s official policy: <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer" class="text-[var(--glow)] underline font-mono-meta">How Google uses information from sites or apps that use our services</a>.
      </p>
    </section>

    <!-- Section 3: Analytics Telemetry -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 3.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Web Analytics & Logs
        </h2>
      </div>

      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
        We utilize <strong>Cloudflare Web Analytics</strong> to monitor general traffic metrics (such as page views, referral sources, and browser performance). Cloudflare Web Analytics is privacy-focused: it does not use cookies, does not collect personal identifiers, and does not track individual user behavior across external websites.
      </p>
    </section>

    <!-- Section 4: Reader Case Submissions -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 4.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Reader Case Submission Data Handling
        </h2>
      </div>

      <div class="prose-dark text-sm text-[var(--color-text-muted)] space-y-3 leading-relaxed">
        <p>
          When you voluntarily submit a paranormal encounter or eyewitness report via our <a href="/submit" class="text-[var(--glow)] underline">Submit Encounter</a> portal, we collect the following submitted data:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li><strong>Submitted Narrative & Incident Metadata:</strong> Case title, incident category, geographical location, date era, and story text.</li>
          <li><strong>Contributor Attribution:</strong> Contributor handle/name or selected anonymous status.</li>
          <li><strong>Contact Email Address:</strong> Required for editorial verification and witness clarification.</li>
        </ul>
        <div class="p-4 rounded bg-black/40 border border-[var(--color-border)] font-mono-meta text-xs text-[var(--color-text-muted)]">
          <span class="text-[var(--status-witnessed)] font-bold">// CONFIDENTIALITY GUARANTEE:</span> Submitted email addresses are stored securely in Cloudflare D1 encrypted database tables and are strictly accessed by editorial staff. We NEVER publish, share, rent, or sell contributor email addresses to third parties.
        </div>
      </div>
    </section>

    <!-- Section 5: GDPR Rights (EU / UK Readers) -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 5.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          GDPR Compliance & Data Rights (EU/UK Readers)
        </h2>
      </div>

      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p>
          Under the General Data Protection Regulation (GDPR) and UK Data Protection Act, readers residing in the European Union or United Kingdom possess specific data subject rights:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>Right of Access:</strong> Request a copy of any personal data (such as reader story submission records) associated with your email address.</li>
          <li><strong>Right to Erasure (Right to be Forgotten):</strong> Request the permanent deletion of your submitted story records or contact information from our database.</li>
          <li><strong>Right to Rectification:</strong> Request corrections to inaccurate submitted details.</li>
          <li><strong>Right to Restrict or Object:</strong> Object to processing of personal data based on legitimate interests.</li>
        </ul>
        <p>
          To exercise any GDPR data subject right, send your request to <a href="mailto:contact@mynightlore.com" class="text-[var(--glow)] underline font-mono-meta">contact@mynightlore.com</a>.
        </p>
      </div>
    </section>

    <!-- Section 6: CCPA / CPRA Disclosures (California Readers) -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 6.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          CCPA / CPRA Disclosures (California Residents)
        </h2>
      </div>

      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p>
          The California Consumer Privacy Act (CCPA) and California Privacy Rights Act (CPRA) require specific disclosures for California residents:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li><strong>No Sale of Personal Information:</strong> Night Lore has not sold, does not sell, and will not sell or share consumer personal information for monetary or valuable consideration.</li>
          <li><strong>Right to Know & Delete:</strong> California residents have the right to request disclosure of personal information collected and request deletion of personal information.</li>
          <li><strong>Non-Discrimination:</strong> We will not discriminate against any user for exercising their privacy rights.</li>
        </ul>
      </div>
    </section>

    <!-- Section 7: Updates & Contact -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 7.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Policy Updates & Privacy Contact
        </h2>
      </div>

      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-6">
        We may update this Privacy Policy periodically to reflect changes in site functionality or legal requirements. Material updates will be indicated by the "LAST UPDATED" date at the top of this page.
      </p>

      <div class="nl-card p-6 bg-[var(--color-surface-2)] text-center">
        <h3 class="text-base font-bold text-[var(--color-text)] mb-2">Privacy & Data Requests</h3>
        <p class="text-xs text-[var(--color-text-muted)] mb-4">
          For privacy inquiries, data deletion requests, or consent management:
        </p>
        <a href="/contact" class="btn-primary text-xs py-2.5 px-5 min-h-[44px] inline-flex items-center justify-center">
          Contact Privacy Desk
        </a>
      </div>
    </section>
  </div>
</Layout>
