---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Terms & Conditions of Service | Night Lore"
  description="Terms and Conditions governing the use of Night Lore, intellectual property ownership, content disclaimers, reader submission licensing, and acceptable site usage."
>
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-10 border-b border-[var(--color-border)] pb-8">
      <div class="flex items-center gap-2 text-xs font-mono-meta text-[var(--color-text-dim)] mb-3">
        <a href="/" class="hover:text-[var(--glow)] transition-colors">ARCHIVE</a>
        <span>/</span>
        <span class="text-[var(--glow)]">TERMS OF SERVICE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">
        Terms & Conditions
      </h1>

      <p class="text-xs font-mono-meta text-[var(--color-text-dim)] mb-2">
        LAST UPDATED: AUGUST 2026 // EFFECTIVE IMMEDIATELY
      </p>

      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        These Terms & Conditions govern your access to and use of Night Lore (<code class="text-[var(--glow)] font-mono-meta text-xs">mynightlore.com</code>). By accessing or browsing our digital archive, you agree to comply with and be bound by these terms.
      </p>
    </div>

    <!-- Section 1: Acceptable Use & Conduct -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 1.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Acceptable Use & Anti-Scraping Policy
        </h2>
      </div>

      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p>
          Night Lore grants you a personal, revocable, non-exclusive, non-transferable license to access and read our published case dossiers and listen to accompanying audio narrations for individual, non-commercial purposes.
        </p>
        <p>
          <strong>Prohibited Conduct:</strong> You agree not to:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>Use automated bots, web scrapers, data-mining software, or crawling tools to bulk extract content, text, or audio from our website.</li>
          <li>Ingest, scrape, or process Night Lore articles or synthesized narration audio for the purpose of training generative AI models, large language models (LLMs), or text-to-speech clones without prior explicit written permission.</li>
          <li>Republish, scrape, or mirror full-length dossiers on commercial content aggregator websites or automated social media content farms.</li>
        </ul>
      </div>
    </section>

    <!-- Section 2: Intellectual Property Rights -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 2.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Intellectual Property Rights
        </h2>
      </div>

      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p>
          All published text dossiers, investigative analyses, site branding, dual-perspective comparative frameworks, and synthesized audio narrations on Night Lore are the intellectual property of Night Lore and protected by copyright laws.
        </p>
        <p>
          <strong>Cover Artwork & Imagery:</strong> Imagery displayed across story covers is licensed, created, or utilized under public domain/Creative Commons licenses with credit provided per our archival licensing documentation. Fair use quotes and historical citations belong to their respective original authors and copyright holders.
        </p>
      </div>
    </section>

    <!-- Section 3: Editorial & Phenomenological Disclaimer -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 3.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Content Disclaimer (Educational & Informational)
        </h2>
      </div>

      <div class="nl-card p-6 bg-[var(--color-surface-2)] border-l-2 border-l-[var(--glow)] text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3 mb-4">
        <p>
          Articles on Night Lore chronicle documented paranormal claims, localized ghost stories, regional folklore, and unsolved historical anomalies. All content is presented for <strong>informational, historical, and entertainment purposes</strong>.
        </p>
        <p>
          Night Lore makes no representations or warranties concerning the scientific reality or supernatural authenticity of unverified claims. We encourage readers to review both supernatural reports and scientific/skeptical explanations presented within our dual-perspective dossiers.
        </p>
      </div>
    </section>

    <!-- Section 4: Reader Story Submission Terms -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 4.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Reader Case Submission License & Moderation
        </h2>
      </div>

      <div class="text-sm text-[var(--color-text-muted)] leading-relaxed space-y-3">
        <p>
          By submitting an encounter narrative or eyewitness report via our <a href="/submit" class="text-[var(--glow)] underline">Submit Encounter</a> portal, you agree to the following terms:
        </p>
        <ul class="list-disc pl-5 space-y-2.5">
          <li><strong>Ownership & Grant of License:</strong> You retain underlying copyright to your personal experience narrative. However, by submitting, you grant Night Lore a perpetual, non-exclusive, worldwide, royalty-free, transferable license to store, archive, publish, translate, narrate via text-to-speech audio, and distribute the submission across current and future digital channels.</li>
          <li><strong>Editorial Moderation Rights:</strong> Night Lore reserves total editorial discretion to approve, edit for clarity, length, and grammar, redact personal identifiers, or reject any submission without prior notice.</li>
          <li><strong>Truthfulness Representation:</strong> You represent that your submitted report reflects an honest eyewitness account or genuine historical research to the best of your knowledge.</li>
        </ul>
      </div>
    </section>

    <!-- Section 5: Limitation of Liability -->
    <section class="mb-10">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 5.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Limitation of Liability
        </h2>
      </div>

      <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
        Night Lore is provided on an "AS IS" and "AS AVAILABLE" basis via serverless Cloudflare Pages Edge infrastructure. We make no representations or warranties of any kind, express or implied, regarding site availability, uptime, or freedom from technical errors. In no event shall Night Lore be liable for any direct, indirect, incidental, or consequential damages resulting from your use or inability to use this site.
      </p>
    </section>

    <!-- Section 6: Contact & Inquiries -->
    <section class="mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="font-mono-meta text-xs text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-2 py-0.5 rounded">
          SECTION 6.0
        </span>
        <h2 class="text-xl font-bold text-[var(--color-text)]">
          Questions & Legal Inquiries
        </h2>
      </div>

      <div class="nl-card p-6 bg-[var(--color-surface-2)] text-center">
        <h3 class="text-base font-bold text-[var(--color-text)] mb-2">Terms & Legal Questions</h3>
        <p class="text-xs text-[var(--color-text-muted)] mb-4">
          For questions regarding these terms, licensing requests, or intellectual property inquiries:
        </p>
        <a href="/contact" class="btn-primary text-xs">
          Contact Legal Desk
        </a>
      </div>
    </section>
  </div>
</Layout>
