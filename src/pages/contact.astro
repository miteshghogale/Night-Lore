---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact Us | Night Lore Archive"
  description="Contact the Night Lore editorial desk for general inquiries, press, editorial corrections, privacy inquiries, or reader story submission guidance."
>
  <div class="max-w-3xl mx-auto">
    <!-- Header -->
    <div class="mb-10 border-b border-[var(--color-border)] pb-8">
      <div class="flex items-center gap-2 text-xs font-mono-meta text-[var(--color-text-dim)] mb-3">
        <a href="/" class="hover:text-[var(--glow)] transition-colors">ARCHIVE</a>
        <span>/</span>
        <span class="text-[var(--glow)]">CONTACT US</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">
        Contact Editorial Desk
      </h1>

      <p class="text-sm sm:text-base text-[var(--color-text-muted)] leading-relaxed">
        Whether you have editorial corrections, historical source citations, press inquiries, or questions regarding privacy disclosures, our inbox is open.
      </p>
    </div>

    <!-- Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- Card 1: Direct Email -->
      <div class="nl-card p-6 flex flex-col justify-between border-l-2 border-l-[var(--glow)]">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[#09090b] border border-[#27272a] flex items-center justify-center mb-4 text-[var(--glow)]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">Direct Inbox</h2>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4">
            For general correspondence, press inquiries, or editorial feedback. Monitored daily.
          </p>
        </div>
        <div>
          <a
            href="mailto:contact@mynightlore.com"
            class="inline-flex items-center gap-2 text-sm font-mono-meta font-bold text-[var(--glow)] hover:underline"
          >
            <span>contact@mynightlore.com</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="text-[11px] font-mono-meta text-[var(--color-text-dim)] mt-1">
            Typical response time: 24–48 hours
          </p>
        </div>
      </div>

      <!-- Card 2: Privacy & Data Desk -->
      <div class="nl-card p-6 flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-lg bg-[#09090b] border border-[#27272a] flex items-center justify-center mb-4 text-[var(--color-text-muted)]">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h2 class="text-lg font-bold text-[var(--color-text)] mb-2">Privacy & Data Desk</h2>
          <p class="text-xs text-[var(--color-text-muted)] leading-relaxed mb-4">
            For GDPR data subject requests, CCPA inquiries, or submission deletion requests.
          </p>
        </div>
        <div>
          <a
            href="mailto:contact@mynightlore.com?subject=Privacy%20Data%20Request"
            class="inline-flex items-center gap-2 text-sm font-mono-meta font-bold text-[var(--color-text)] hover:text-[var(--glow)] transition-colors"
          >
            <span>contact@mynightlore.com</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
          <p class="text-[11px] font-mono-meta text-[var(--color-text-dim)] mt-1">
            Subject: Privacy Data Request
          </p>
        </div>
      </div>
    </div>

    <!-- Reader Story Submission Callout Banner -->
    <div class="nl-card p-8 bg-[var(--color-surface-2)] border border-[var(--color-border)] mb-12 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded bg-black border border-[var(--color-border)] font-mono-meta text-[11px] text-[var(--status-witnessed)] mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          PARANORMAL ENCOUNTER SUBMISSIONS
        </div>
        <h3 class="text-lg font-bold text-[var(--color-text)] mb-1">
          Have an Eyewitness Account to Report?
        </h3>
        <p class="text-xs text-[var(--color-text-muted)] max-w-lg leading-relaxed">
          Do not email raw story narratives directly. Please use our structured submission portal to specify incident location, category taxonomy, and anonymization preferences.
        </p>
      </div>
      <a href="/submit" class="btn-primary text-xs whitespace-nowrap px-6 py-3 shadow-md">
        Go to Submission Portal →
      </a>
    </div>

    <!-- Additional Editorial Guidelines Notice -->
    <div class="space-y-6 text-sm text-[var(--color-text-muted)] leading-relaxed border-t border-[var(--color-border)] pt-8">
      <h3 class="text-base font-bold text-[var(--color-text)]">
        Editorial Corrections & Citation Verification
      </h3>
      <p>
        If you spot a factual error, broken source citation, or timeline discrepancy in any published dossier, please email us with:
      </p>
      <ul class="list-disc pl-5 space-y-2 text-xs font-mono-meta text-[var(--color-text-muted)]">
        <li>The full URL of the dossier in question</li>
        <li>The specific paragraph or claim requiring correction</li>
        <li>Primary or secondary documentation supporting the correction</li>
      </ul>
      <p class="text-xs text-[var(--color-text-dim)]">
        We review all citation corrections promptly and update published dossiers with editorial logs when verified.
      </p>
    </div>
  </div>
</Layout>
