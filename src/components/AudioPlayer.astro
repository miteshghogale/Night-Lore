---
// AudioPlayer.astro - Sticky bottom audio player for ElevenLabs narrated stories
---

<div
  id="global-audio-player"
  class="fixed bottom-0 left-0 right-0 z-50 transform translate-y-full transition-transform duration-300 ease-in-out border-t border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xl backdrop-blur-md"
  aria-label="Audio narration player"
>
  <div class="max-w-[1200px] mx-auto px-4 py-3 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-3 sm:gap-6">
    <!-- Story Info -->
    <div class="flex items-center gap-3 w-full sm:w-auto min-w-0">
      <button
        id="player-play-btn"
        class="w-10 h-10 rounded-md bg-[var(--glow)] text-black flex items-center justify-center flex-shrink-0 hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-[var(--glow)] cursor-pointer"
        aria-label="Play or pause narration"
      >
        <svg id="play-icon" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M8 5v14l11-7z"/>
        </svg>
        <svg id="pause-icon" class="w-5 h-5 fill-current hidden" viewBox="0 0 24 24">
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
        </svg>
      </button>

      <div class="min-w-0 flex-1">
        <div class="flex items-center gap-2">
          <span class="font-mono-meta text-[10px] tracking-wider uppercase text-[var(--glow)] border border-[rgba(255,107,74,0.3)] px-1.5 py-0.5 rounded">
            AUDIO NARRATION
          </span>
        </div>
        <p id="player-title" class="text-sm font-medium text-[var(--color-text)] truncate mt-0.5">
          Select a story to play narration
        </p>
      </div>
    </div>

    <!-- Progress & Controls -->
    <div class="flex items-center gap-3 w-full sm:w-1/2 max-w-xl">
      <span id="player-time" class="font-mono-meta text-xs text-[var(--color-text-dim)] w-12 text-right">0:00</span>
      
      <div class="relative flex-1 flex items-center">
        <input
          type="range"
          id="player-seek"
          min="0"
          max="100"
          value="0"
          class="w-full h-1.5 bg-[var(--color-surface-2)] rounded-lg appearance-none cursor-pointer accent-[var(--glow)] focus:outline-none"
          aria-label="Seek audio position"
        />
      </div>

      <span id="player-duration" class="font-mono-meta text-xs text-[var(--color-text-dim)] w-12">0:00</span>
    </div>

    <!-- Actions & Close -->
    <div class="flex items-center gap-2 self-end sm:self-center">
      <button
        id="player-close-btn"
        class="text-[var(--color-text-dim)] hover:text-[var(--color-text)] p-2 rounded-md transition-colors focus:outline-none"
        aria-label="Close audio player"
      >
        <svg class="w-5 h-5 stroke-current" fill="none" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <audio id="audio-element" class="hidden" preload="none"></audio>
</div>

<script>
  // Global Audio Controller
  class GlobalAudioPlayer {
    player: HTMLElement | null;
    audio: HTMLAudioElement | null;
    playBtn: HTMLElement | null;
    playIcon: HTMLElement | null;
    pauseIcon: HTMLElement | null;
    titleEl: HTMLElement | null;
    timeEl: HTMLElement | null;
    durationEl: HTMLElement | null;
    seekInput: HTMLInputElement | null;
    closeBtn: HTMLElement | null;
    currentUrl: string | null = null;

    constructor() {
      this.player = document.getElementById('global-audio-player');
      this.audio = document.getElementById('audio-element') as HTMLAudioElement;
      this.playBtn = document.getElementById('player-play-btn');
      this.playIcon = document.getElementById('play-icon');
      this.pauseIcon = document.getElementById('pause-icon');
      this.titleEl = document.getElementById('player-title');
      this.timeEl = document.getElementById('player-time');
      this.durationEl = document.getElementById('player-duration');
      this.seekInput = document.getElementById('player-seek') as HTMLInputElement;
      this.closeBtn = document.getElementById('player-close-btn');

      this.init();
    }

    init() {
      if (!this.audio || !this.player) return;

      // Event Listener for global trigger
      window.addEventListener('nl:play-audio', (e: Event) => {
        const customEv = e as CustomEvent<{ url: string; title: string }>;
        if (customEv.detail) {
          this.play(customEv.detail.url, customEv.detail.title);
        }
      });

      // Play/Pause button
      this.playBtn?.addEventListener('click', () => this.togglePlay());

      // Close button
      this.closeBtn?.addEventListener('click', () => this.stopAndClose());

      // Time updates
      this.audio.addEventListener('timeupdate', () => this.onTimeUpdate());

      // Loaded metadata
      this.audio.addEventListener('loadedmetadata', () => {
        if (this.durationEl && this.audio) {
          this.durationEl.textContent = this.formatTime(this.audio.duration);
        }
      });

      // Ended
      this.audio.addEventListener('ended', () => {
        this.setPlayState(false);
      });

      // Seek bar input
      this.seekInput?.addEventListener('input', () => {
        if (this.audio && this.audio.duration && this.seekInput) {
          const seekTo = (parseFloat(this.seekInput.value) / 100) * this.audio.duration;
          this.audio.currentTime = seekTo;
        }
      });
    }

    play(url: string, title: string) {
      if (!this.audio || !this.player) return;

      if (this.currentUrl !== url) {
        this.currentUrl = url;
        this.audio.src = url;
        if (this.titleEl) this.titleEl.textContent = title;
      }

      // Show player
      this.player.classList.remove('translate-y-full');

      this.audio.play().then(() => {
        this.setPlayState(true);
      }).catch(err => {
        console.warn('Audio play interrupted:', err);
      });
    }

    togglePlay() {
      if (!this.audio) return;
      if (this.audio.paused) {
        this.audio.play();
        this.setPlayState(true);
      } else {
        this.audio.pause();
        this.setPlayState(false);
      }
    }

    setPlayState(isPlaying: boolean) {
      if (isPlaying) {
        this.playIcon?.classList.add('hidden');
        this.pauseIcon?.classList.remove('hidden');
      } else {
        this.playIcon?.classList.remove('hidden');
        this.pauseIcon?.classList.add('hidden');
      }
    }

    stopAndClose() {
      if (this.audio) {
        this.audio.pause();
        this.audio.currentTime = 0;
      }
      this.setPlayState(false);
      this.player?.classList.add('translate-y-full');
    }

    onTimeUpdate() {
      if (!this.audio || !this.timeEl || !this.seekInput) return;
      this.timeEl.textContent = this.formatTime(this.audio.currentTime);
      if (this.audio.duration) {
        const pct = (this.audio.currentTime / this.audio.duration) * 100;
        this.seekInput.value = pct.toString();
      }
    }

    formatTime(secs: number): string {
      if (isNaN(secs)) return '0:00';
      const m = Math.floor(secs / 60);
      const s = Math.floor(secs % 60);
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', () => {
    new GlobalAudioPlayer();
  });
</script>
