---
import StatusBadge from './StatusBadge.astro';

interface Props {
  title: string;
  dek: string;
  slug: string;
  category: string;
  status: 'unresolved' | 'witnessed' | 'disputed' | 'debunked' | 'ongoing';
  location: string;
  eventDate: string;
  pubDate: Date | string;
  audioDuration?: string;
  coverImage?: string;
  coverAlt?: string;
}

const { title, dek, slug, category, status, location, eventDate, pubDate, audioDuration } = Astro.props;

const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---

<article class="nl-card eerie-card-bg group cursor-pointer relative overflow-hidden flex flex-col h-full border border-[var(--color-border)] rounded-xl">
  <!-- Glowing Eerie Top Accent Line -->
  <div class="eerie-card-accent-line"></div>

  <!-- Drifting Eerie Fog Background Animation Layer -->
  <div class="eerie-fog-layer"></div>

  <!-- Card Main Content -->
  <div class="p-4 sm:p-6 flex flex-col justify-between flex-1 relative z-10">
    <div>
      <!-- Top Metadata Header Ribbon -->
      <div class="flex items-center justify-between gap-2 mb-4 flex-wrap">
        <StatusBadge status={status} />
        <span class="font-mono-meta text-[11px] text-[var(--color-text-dim)] bg-black/50 px-2 py-0.5 rounded border border-white/10 flex-shrink-0">
          {category}
        </span>
      </div>

      <!-- Dossier Record Stamp -->
      <div class="font-mono-meta text-[11px] text-[var(--color-text-dim)] mb-2.5 tracking-wider flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--glow)]/70 animate-pulse flex-shrink-0"></span>
        <span class="truncate">DOSSIER NL-{slug.toUpperCase()}</span>
      </div>

      <!-- Story Title -->
      <h3 class="text-base sm:text-xl font-bold tracking-tight text-[var(--color-text)] group-hover:text-[var(--glow)] transition-colors mb-3 line-clamp-2 leading-snug break-words">
        <a href={`/story/${slug}`} class="focus:outline-none">
          <span class="absolute inset-0 z-10"></span>
          {title}
        </a>
      </h3>

      <!-- Story Dek / Summary -->
      <p class="text-xs sm:text-sm text-[var(--color-text-muted)] line-clamp-3 leading-relaxed mb-6 font-normal">
        {dek}
      </p>
    </div>

    <!-- Card Footer Ribbon -->
    <div class="pt-4 border-t border-[var(--color-border)] flex items-center justify-between text-xs font-mono-meta text-[var(--color-text-dim)] flex-wrap gap-2 z-20">
      <div class="flex items-center gap-1.5 truncate max-w-[48%] sm:max-w-[60%]">
        <svg class="w-3.5 h-3.5 flex-shrink-0 text-[var(--glow)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="truncate">{location}</span>
      </div>

      <div class="flex items-center gap-3 flex-shrink-0">
        {audioDuration && (
          <span class="flex items-center gap-1 text-[var(--glow)] font-medium bg-[var(--glow-soft)] px-1.5 py-0.5 rounded border border-[var(--glow)]/20">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
            </svg>
            {audioDuration}
          </span>
        )}
        <span>{formattedDate}</span>
      </div>
    </div>
  </div>
</article>


