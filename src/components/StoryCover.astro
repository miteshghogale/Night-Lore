---
interface Props {
  src: string;
  alt: string;
  credit?: string;
  creditUrl?: string;
  license?: string;
}

const { src, alt, credit, creditUrl, license } = Astro.props;
---

<div class="mb-8">
  <div class="relative overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-2)] shadow-2xl">
    <img
      src={src}
      alt={alt}
      class="w-full h-auto max-h-[500px] object-cover"
      loading="eager"
      decoding="async"
    />
  </div>
  {credit && (
    <div class="mt-2 text-right font-mono-meta text-[11px] text-[var(--color-text-dim)] flex items-center justify-end gap-1 flex-wrap">
      <svg class="w-3 h-3 text-[var(--color-text-dim)] inline flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span>Photo: </span>
      {creditUrl ? (
        <a
          href={creditUrl}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="underline underline-offset-2 hover:text-[var(--glow)] transition-colors"
        >
          {credit}
        </a>
      ) : (
        <span>{credit}</span>
      )}
      <span>, {license || 'Wikimedia Commons'} via Wikimedia Commons</span>
    </div>
  )}
</div>
