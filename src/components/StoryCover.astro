---
interface Props {
  src: string;
  alt: string;
  credit?: string;
  creditUrl?: string;
  license?: string;
  caption?: string;
}

const { src, alt, credit, creditUrl, license, caption } = Astro.props;
---

<figure class="archival-frame mb-10 group">
  <!-- Top Archival Frame Header Ribbon -->
  <div class="archival-header-ribbon">
    <div class="flex items-center gap-2">
      <svg class="w-3.5 h-3.5 text-[var(--glow)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
      <span class="tracking-wider uppercase font-mono-meta">// ARCHIVAL EVIDENCE IMAGE FILE</span>
    </div>
    <span class="text-[var(--color-text-dim)] font-mono-meta hidden sm:inline">HIGH RESOLUTION ARCHIVE</span>
  </div>

  <!-- Image Aspect Ratio Wrapper -->
  <div class="archival-image-wrapper aspect-[21/9] sm:aspect-[2.2/1]">
    <img
      src={src}
      alt={alt}
      loading="eager"
      decoding="async"
    />
    <div class="cover-gradient-overlay"></div>
  </div>

  <!-- Caption & Attribution Bar -->
  <figcaption class="archival-caption-bar">
    <div class="flex items-center gap-2 flex-1 min-w-[200px]">
      <span class="w-1.5 h-1.5 rounded-full bg-[var(--glow)] flex-shrink-0"></span>
      <span class="text-[var(--color-text-muted)] line-clamp-1">{alt}</span>
    </div>

    {credit && (
      <div class="flex items-center gap-1 text-[11px] text-[var(--color-text-dim)] flex-shrink-0">
        <span>Source:</span>
        {creditUrl ? (
          <a
            href={creditUrl}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="text-[var(--color-text-muted)] underline underline-offset-2 hover:text-[var(--glow)] transition-colors"
          >
            {credit}
          </a>
        ) : (
          <span class="text-[var(--color-text-muted)]">{credit}</span>
        )}
        <span>({license || 'Public Domain'})</span>
      </div>
    )}
  </figcaption>
</figure>

