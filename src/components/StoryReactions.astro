---
interface Props {
  storySlug: string;
  class?: string;
}

const { storySlug, class: className = '' } = Astro.props;
---

<div
  class={`nl-card p-6 sm:p-8 border border-[var(--color-border)] bg-[var(--color-surface)] mb-10 ${className}`}
  data-reactions-container
  data-story-slug={storySlug}
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 pb-4 border-b border-[var(--color-border)]">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[var(--glow)] animate-pulse"></span>
        <h3 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)]">
          // READER CASE EVALUATION
        </h3>
      </div>
      <p class="text-sm font-semibold text-[var(--color-text)] mt-1">
        How does this dossier affect your assessment?
      </p>
    </div>
    <span class="font-mono-meta text-[11px] text-[var(--color-text-dim)] bg-black/40 px-2.5 py-1 rounded border border-white/5 self-start sm:self-auto">
      ANONYMOUS READER POLL
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <!-- Reaction 1: Unsettling -->
    <button
      type="button"
      data-reaction-btn="unsettling"
      class="nl-reaction-btn status-stamp group relative flex items-center justify-between p-3.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-2)] text-[var(--color-text-muted)] hover:border-[var(--glow)] hover:text-[var(--glow)] hover:bg-black/60 transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:border-[var(--color-border)] disabled:hover:text-[var(--color-text-muted)]"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Eerie Flame / Eye Icon -->
        <svg class="w-4 h-4 flex-shrink-0 text-[var(--glow)] group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9.879z" />
        </svg>
        <span class="font-mono-meta text-xs font-semibold tracking-wider text-left truncate">UNSETTLING</span>
      </div>
      <span class="font-mono-meta text-xs text-[var(--color-text-dim)] group-hover:text-[var(--glow)] ml-2 flex-shrink-0" data-count-for="unsettling">
        · 0
      </span>
    </button>

    <!-- Reaction 2: Still Unsolved -->
    <button
      type="button"
      data-reaction-btn="unsolved"
      class="nl-reaction-btn status-stamp group relative flex items-center justify-between p-3.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-2)] text-[var(--color-text-muted)] hover:border-[var(--glow)] hover:text-[var(--glow)] hover:bg-black/60 transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:border-[var(--color-border)] disabled:hover:text-[var(--color-text-muted)]"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Search Dossier Icon -->
        <svg class="w-4 h-4 flex-shrink-0 text-amber-500 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 11V8m0 6h.01" />
        </svg>
        <span class="font-mono-meta text-xs font-semibold tracking-wider text-left truncate">STILL UNSOLVED</span>
      </div>
      <span class="font-mono-meta text-xs text-[var(--color-text-dim)] group-hover:text-amber-500 ml-2 flex-shrink-0" data-count-for="unsolved">
        · 0
      </span>
    </button>

    <!-- Reaction 3: Couldn't Sleep -->
    <button
      type="button"
      data-reaction-btn="nosleep"
      class="nl-reaction-btn status-stamp group relative flex items-center justify-between p-3.5 rounded-lg border border-[var(--color-border)] bg-[var(--color-surface-2)] text-[var(--color-text-muted)] hover:border-[var(--glow)] hover:text-[var(--glow)] hover:bg-black/60 transition-all duration-200 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:border-[var(--color-border)] disabled:hover:text-[var(--color-text-muted)]"
    >
      <div class="flex items-center gap-2.5 min-w-0">
        <!-- Crescent Moon / Eye Icon -->
        <svg class="w-4 h-4 flex-shrink-0 text-indigo-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
        <span class="font-mono-meta text-xs font-semibold tracking-wider text-left truncate">COULDN'T SLEEP</span>
      </div>
      <span class="font-mono-meta text-xs text-[var(--color-text-dim)] group-hover:text-indigo-400 ml-2 flex-shrink-0" data-count-for="nosleep">
        · 0
      </span>
    </button>
  </div>
</div>

<script>
  function initStoryReactions() {
    const containers = document.querySelectorAll<HTMLElement>('[data-reactions-container]');

    containers.forEach((container) => {
      if (container.getAttribute('data-reactions-initialized') === 'true') return;
      container.setAttribute('data-reactions-initialized', 'true');

      const slug = container.getAttribute('data-story-slug');
      if (!slug) return;

      const buttons = container.querySelectorAll<HTMLButtonElement>('.nl-reaction-btn');

      function getStorageKey(type: string) {
        return `nl_reacted_${slug}_${type}`;
      }

      function isReacted(type: string): boolean {
        try {
          return localStorage.getItem(getStorageKey(type)) === 'true';
        } catch {
          return false;
        }
      }

      function markReacted(type: string) {
        try {
          localStorage.setItem(getStorageKey(type), 'true');
        } catch {}
      }

      function updateButtonUI(btn: HTMLButtonElement, type: string, count: number, hasReacted: boolean) {
        const countEl = btn.querySelector(`[data-count-for="${type}"]`);
        if (countEl) {
          countEl.textContent = `· ${count}`;
        }

        if (hasReacted) {
          btn.disabled = true;
          btn.classList.add('border-zinc-700', 'bg-zinc-900/60', 'text-zinc-400', 'opacity-75');
          btn.setAttribute('title', 'You recorded this reaction');
          if (countEl) {
            countEl.classList.add('text-[var(--glow)]', 'font-bold');
          }
        }
      }

      // Initial check & GET request
      buttons.forEach((btn) => {
        const type = btn.getAttribute('data-reaction-btn');
        if (type && isReacted(type)) {
          btn.disabled = true;
          btn.classList.add('opacity-75');
        }
      });

      fetch(`/api/react?slug=${encodeURIComponent(slug)}`)
        .then((res) => res.json())
        .then((data) => {
          if (data && data.success && data.counts) {
            buttons.forEach((btn) => {
              const type = btn.getAttribute('data-reaction-btn');
              if (!type) return;
              const count = data.counts[type] || 0;
              const reacted = isReacted(type);
              updateButtonUI(btn, type, count, reacted);
            });
          }
        })
        .catch((err) => {
          console.warn('Could not load reactions:', err);
        });

      // Handle button click events
      buttons.forEach((btn) => {
        const type = btn.getAttribute('data-reaction-btn');
        if (!type) return;

        btn.addEventListener('click', () => {
          if (btn.disabled || isReacted(type)) return;

          // Optimistic UI update
          const countEl = btn.querySelector(`[data-count-for="${type}"]`);
          let currentCount = 0;
          if (countEl && countEl.textContent) {
            const match = countEl.textContent.match(/\d+/);
            if (match) currentCount = parseInt(match[0], 10);
            countEl.textContent = `· ${currentCount + 1}`;
          }

          markReacted(type);
          updateButtonUI(btn, type, currentCount + 1, true);

          // POST to backend API
          fetch('/api/react', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ story_slug: slug, reaction_type: type })
          })
            .then((res) => res.json())
            .then((data) => {
              if (data && data.success && data.counts) {
                updateButtonUI(btn, type, data.counts[type] || currentCount + 1, true);
              }
            })
            .catch((err) => {
              console.error('Reaction submission failed:', err);
            });
        });
      });
    });
  }

  // Initialize on page load & Astro ViewTransitions
  initStoryReactions();
  document.addEventListener('astro:page-load', initStoryReactions);
</script>
