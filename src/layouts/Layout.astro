---
import '../styles/global.css';
import AudioPlayer from '../components/AudioPlayer.astro';
import { CATEGORIES } from '../utils/categories';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleMeta?: {
    publishedTime: string;
    updatedTime?: string;
    category: string;
    tags: string[];
    audioUrl?: string;
    audioDuration?: string;
  };
  breadcrumbs?: BreadcrumbItem[];
  isHome?: boolean;
  faqList?: { question: string; answer: string }[];
  noindex?: boolean;
}

const siteUrl = (import.meta.env.SITE_URL || Astro.site?.href || 'https://mynightlore.com').replace(/\/$/, '');

const {
  title = 'Night Lore — Real Ghost Stories & Documented Hauntings',
  description = 'Night Lore documents real hauntings, unsolved mysteries, urban legends, and reader-submitted paranormal experiences. Researched, sourced, and factual.',
  image = `${siteUrl}/og-image.jpg`,
  articleMeta,
  breadcrumbs,
  isHome = false,
  faqList,
  noindex = false
} = Astro.props;

const canonicalURL = `${siteUrl}${Astro.url.pathname}`;
const categoryList = Object.values(CATEGORIES);

// Helper for ISO 8601 duration format (e.g. "11:35" -> "PT11M35S")
function formatIsoDuration(durationStr?: string): string | undefined {
  if (!durationStr) return undefined;
  if (durationStr.startsWith('P')) return durationStr;
  const parts = durationStr.split(':').map(Number);
  if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
    return `PT${parts[0]}M${parts[1]}S`;
  } else if (parts.length === 3 && !isNaN(parts[0]) && !isNaN(parts[1]) && !isNaN(parts[2])) {
    return `PT${parts[0]}H${parts[1]}M${parts[2]}S`;
  }
  return undefined;
}

// Build Homepage Schema (WebSite + Organization)
const websiteSchema = isHome ? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Night Lore",
      "description": description,
      "publisher": {
        "@id": `${siteUrl}/#organization`
      }
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Night Lore",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/apple-touch-icon.png`
      },
      "description": "An independent, non-fictional research archive documenting real hauntings, unsolved anomalies, urban folklore, and eyewitness accounts."
    }
  ]
} : null;

// Build AudioObject Schema for audio narration
const audioSchema = (articleMeta && articleMeta.audioUrl) ? {
  "@context": "https://schema.org",
  "@type": "AudioObject",
  "name": `${title} (Audio Narration)`,
  "description": description,
  "contentUrl": articleMeta.audioUrl.startsWith('http') ? articleMeta.audioUrl : `${siteUrl}${articleMeta.audioUrl}`,
  "encodingFormat": "audio/mpeg",
  "duration": formatIsoDuration(articleMeta.audioDuration),
  "uploadDate": articleMeta.publishedTime,
  "author": {
    "@type": "Organization",
    "name": "Night Lore",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Night Lore",
    "url": siteUrl
  }
} : null;

// Build Article Schema for story pages (Article, NOT NewsArticle)
const articleSchema = articleMeta ? {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "headline": title,
  "description": description,
  "url": canonicalURL,
  "image": [image],
  "datePublished": articleMeta.publishedTime,
  "dateModified": articleMeta.updatedTime || articleMeta.publishedTime,
  "author": {
    "@type": "Organization",
    "name": "Night Lore",
    "url": siteUrl
  },
  "publisher": {
    "@type": "Organization",
    "name": "Night Lore",
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/apple-touch-icon.png`
    }
  },
  "articleSection": articleMeta.category,
  "keywords": articleMeta.tags.join(', '),
  ...(audioSchema ? {
    "audio": {
      "@type": "AudioObject",
      "name": audioSchema.name,
      "contentUrl": audioSchema.contentUrl,
      "encodingFormat": audioSchema.encodingFormat,
      "duration": audioSchema.duration
    }
  } : {})
} : null;

// Build BreadcrumbList Schema
const breadcrumbSchema = (breadcrumbs && breadcrumbs.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": crumb.url.startsWith('http') ? crumb.url : `${siteUrl}${crumb.url}`
  }))
} : null;

// Build FAQPage Schema
const faqSchema = (faqList && faqList.length > 0) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
} : null;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}

    <!-- Google Fonts for Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Night Lore Editorial Team" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Night Lore" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- JSON-LD Structured Data Blocks -->
    {websiteSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    )}
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    {audioSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(audioSchema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-grain text-[var(--color-text)] flex flex-col min-h-screen">
    <!-- Header Nav -->
    <header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[#000000]/85 backdrop-blur-lg">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <!-- Brand Mark -->
        <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Night Lore Home">
          <div class="w-8 h-8 rounded-lg bg-[#09090b] border border-[#27272a] flex items-center justify-center group-hover:border-[var(--glow)] transition-colors p-1.5 shadow-md">
            <svg width="22" height="22" viewBox="0 0 32 32" fill="none" class="w-full h-full">
              <circle cx="16" cy="16" r="12.5" stroke="#3f3f46" stroke-width="2.75" class="group-hover:stroke-[#52525b] transition-colors"/>
              <path d="M 16 3.5 A 12.5 12.5 0 0 1 28.5 16" stroke="var(--glow)" stroke-width="2.75" stroke-linecap="round"/>
              <circle cx="16" cy="16" r="4.25" fill="var(--glow)" class="shadow-[0_0_8px_var(--glow)]"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-base tracking-tight text-[var(--color-text)] group-hover:text-[var(--glow)] transition-colors leading-none">
              NIGHT LORE
            </span>
            <span class="font-mono-meta text-[10px] text-[var(--color-text-dim)] tracking-widest leading-none mt-1">
              PARANORMAL ARCHIVE
            </span>
          </div>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-8 text-xs font-mono-meta text-[var(--color-text-muted)]">
          <a href="/" class="hover:text-[var(--glow)] transition-colors uppercase tracking-wider">Archive Home</a>
          <a href="/category/real-paranormal-cases" class="hover:text-[var(--glow)] transition-colors uppercase tracking-wider">Paranormal Cases</a>
          <a href="/category/unsolved-mysteries" class="hover:text-[var(--glow)] transition-colors uppercase tracking-wider">Unsolved Mysteries</a>
          <a href="/about" class="hover:text-[var(--glow)] transition-colors uppercase tracking-wider">Editorial Standards</a>
        </nav>

        <!-- Right Action & Mobile Menu Button -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a href="/submit" class="btn-primary text-xs py-2.5 px-4 min-h-[44px] shadow-sm">
            <svg class="w-3.5 h-3.5 stroke-current" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline">Submit Encounter</span>
            <span class="sm:hidden">Submit</span>
          </a>

          <button
            id="mobile-menu-btn"
            class="md:hidden p-2.5 min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] focus:outline-none cursor-pointer"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Nav Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[#09090b]/95 backdrop-blur-md px-4 py-3 space-y-1 font-mono-meta text-xs">
        <a href="/" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)] border-b border-white/5">ARCHIVE HOME</a>
        <a href="/category/real-paranormal-cases" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)] border-b border-white/5">REAL PARANORMAL CASES</a>
        <a href="/category/unsolved-mysteries" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)] border-b border-white/5">UNSOLVED MYSTERIES</a>
        <a href="/category/haunted-places" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)] border-b border-white/5">HAUNTED PLACES</a>
        <a href="/about" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)] border-b border-white/5">EDITORIAL STANDARDS</a>
        <a href="/contact" class="flex items-center py-3 px-2 min-h-[44px] text-[var(--color-text-muted)] hover:text-[var(--glow)]">CONTACT US</a>
      </div>
    </header>

    <!-- Main Body Slot -->
    <main class="flex-1 w-full max-w-[1280px] mx-auto px-4 sm:px-6 py-8 sm:py-12 pb-28 sm:pb-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] mt-24 relative overflow-hidden">
      <div class="max-w-[1280px] mx-auto px-4 sm:px-6 py-12 sm:py-16 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Purpose -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-7 h-7 rounded-md bg-[#09090b] border border-[#27272a] flex items-center justify-center p-1">
                <svg width="18" height="18" viewBox="0 0 32 32" fill="none" class="w-full h-full">
                  <circle cx="16" cy="16" r="12.5" stroke="#3f3f46" stroke-width="2.75"/>
                  <path d="M 16 3.5 A 12.5 12.5 0 0 1 28.5 16" stroke="var(--glow)" stroke-width="2.75" stroke-linecap="round"/>
                  <circle cx="16" cy="16" r="4.25" fill="var(--glow)"/>
                </svg>
              </div>
              <span class="font-extrabold text-base tracking-tight text-[var(--color-text)]">NIGHT LORE</span>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-md mb-4">
              An independent, non-fictional research archive documenting real ghost stories, hauntings, unsolved anomalies, urban folklore, and eyewitness accounts.
            </p>
            <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-black border border-[var(--color-border)] font-mono-meta text-[11px] text-[var(--color-text-dim)]">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              ARCHIVE STATUS: ACTIVE // CLOUDFLARE EDGE
            </div>
          </div>

          <!-- Column 2: Categories -->
          <div>
            <h4 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-4">// TAXONOMY INDEX</h4>
            <ul class="space-y-2.5 text-xs font-mono-meta text-[var(--color-text-muted)]">
              {categoryList.slice(0, 4).map(cat => (
                <li>
                  <a href={`/category/${cat.slug}`} class="hover:text-[var(--glow)] transition-colors">
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 3: Trust & Legal -->
          <div>
            <h4 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-4">// STANDARDS & LEGAL</h4>
            <ul class="space-y-2.5 text-xs font-mono-meta text-[var(--color-text-muted)]">
              <li><a href="/about" class="hover:text-[var(--glow)] transition-colors">About & Editorial Standards</a></li>
              <li><a href="/privacy-policy" class="hover:text-[var(--glow)] transition-colors">Privacy Policy</a></li>
              <li><a href="/terms-and-conditions" class="hover:text-[var(--glow)] transition-colors">Terms & Conditions</a></li>
              <li><a href="/contact" class="hover:text-[var(--glow)] transition-colors">Contact Us</a></li>
              <li><a href="/submit" class="hover:text-[var(--glow)] transition-colors">Submit Encounter</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between text-xs font-mono-meta text-[var(--color-text-dim)] gap-4">
          <p>© {new Date().getFullYear()} Night Lore Archive. All rights reserved.</p>
          <p>Strictly non-fictional research & sourced archival documentation.</p>
        </div>
      </div>
    </footer>

    <!-- Global Audio Player -->
    <AudioPlayer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        menuBtn?.addEventListener('click', () => {
          const isHidden = menu?.classList.toggle('hidden');
          menuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
        });
      });
    </script>
  </body>
</html>
