---
import '../styles/global.css';
import AudioPlayer from '../components/AudioPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  articleMeta?: {
    publishedTime: string;
    category: string;
    tags: string[];
  };
}

const {
  title = 'Night Lore: Researched Paranormal Archive & Unsolved Case Files',
  description = 'Night Lore documents real hauntings, unsolved mysteries, urban legends, and reader-submitted paranormal experiences. Researched, sourced, and factual.',
  image = 'https://mynightlore.com/og-image.jpg',
  articleMeta
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://mynightlore.com');

const categories = [
  'Real Paranormal Cases',
  'Country Stories',
  'Haunted Places',
  'Unsolved Mysteries',
  'Urban Legends',
  'First-Person Accounts',
  'Movie Inspiration',
  'Psychology of Fear'
];
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts for Geist Sans & Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Night Lore Editorial Team" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleMeta ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Night Lore" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Structured Data (JSON-LD) for SEO -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": articleMeta ? "NewsArticle" : "WebSite",
      "headline": title,
      "description": description,
      "url": canonicalURL,
      "publisher": {
        "@type": "Organization",
        "name": "Night Lore",
        "url": "https://mynightlore.com",
        "logo": "https://mynightlore.com/favicon.svg"
      },
      ...(articleMeta ? {
        "datePublished": articleMeta.publishedTime,
        "articleSection": articleMeta.category,
        "keywords": articleMeta.tags.join(', ')
      } : {})
    })} />
  </head>
  <body class="bg-grain text-[var(--color-text)] flex flex-col min-h-screen">
    <!-- Header Nav -->
    <header class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[#000000]/80 backdrop-blur-md">
      <div class="max-w-[1200px] mx-auto px-4 h-16 flex items-center justify-between gap-4">
        <!-- Brand Mark -->
        <a href="/" class="flex items-center gap-2.5 group focus:outline-none">
          <div class="w-7 h-7 rounded-md bg-[var(--color-surface)] border border-[var(--color-border)] flex items-center justify-center group-hover:border-[var(--glow)] transition-colors">
            <span class="w-2.5 h-2.5 rounded-full bg-[var(--glow)] shadow-[0_0_8px_var(--glow)]"></span>
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-base tracking-tight text-[var(--color-text)] group-hover:text-[var(--glow)] transition-colors">
              NIGHT LORE
            </span>
          </div>
        </a>

        <!-- Desktop Nav -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[var(--color-text-muted)]">
          <a href="/" class="hover:text-[var(--color-text)] transition-colors">Archive</a>
          <a href="/category/Real Paranormal Cases" class="hover:text-[var(--color-text)] transition-colors">Cases</a>
          <a href="/category/Unsolved Mysteries" class="hover:text-[var(--color-text)] transition-colors">Mysteries</a>
          <a href="/about" class="hover:text-[var(--color-text)] transition-colors">Editorial Policy</a>
        </nav>

        <!-- Right Action & Mobile Menu Button -->
        <div class="flex items-center gap-3">
          <a href="/submit" class="btn-primary text-xs py-2 px-3.5">
            <svg class="w-3.5 h-3.5 stroke-current" fill="none" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            <span class="hidden sm:inline">Submit Encounter</span>
            <span class="sm:hidden">Submit</span>
          </a>

          <button
            id="mobile-menu-btn"
            class="md:hidden p-2 rounded-md border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-text-muted)] hover:text-[var(--color-text)] focus:outline-none"
            aria-label="Toggle navigation menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Nav Menu -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-4 space-y-3 font-mono-meta text-xs">
        <a href="/" class="block py-2 text-[var(--color-text-muted)] hover:text-[var(--glow)]">ARCHIVE HOME</a>
        <a href="/category/Real Paranormal Cases" class="block py-2 text-[var(--color-text-muted)] hover:text-[var(--glow)]">REAL PARANORMAL CASES</a>
        <a href="/category/Unsolved Mysteries" class="block py-2 text-[var(--color-text-muted)] hover:text-[var(--glow)]">UNSOLVED MYSTERIES</a>
        <a href="/category/Haunted Places" class="block py-2 text-[var(--color-text-muted)] hover:text-[var(--glow)]">HAUNTED PLACES</a>
        <a href="/about" class="block py-2 text-[var(--color-text-muted)] hover:text-[var(--glow)]">EDITORIAL POLICY</a>
      </div>
    </header>

    <!-- Main Body Slot -->
    <main class="flex-1 w-full max-w-[1200px] mx-auto px-4 py-8 sm:py-12">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] mt-20">
      <div class="max-w-[1200px] mx-auto px-4 py-12 sm:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
          <!-- Column 1: Brand & Purpose -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-2.5 mb-3">
              <span class="w-2.5 h-2.5 rounded-full bg-[var(--glow)] shadow-[0_0_8px_var(--glow)]"></span>
              <span class="font-bold text-base tracking-tight text-[var(--color-text)]">NIGHT LORE</span>
            </div>
            <p class="text-sm text-[var(--color-text-muted)] leading-relaxed max-w-md mb-4">
              An independent, researched archive documenting real hauntings, unsolved anomalies, urban folklore, and eyewitness accounts. Every case presents both paranormal claims and critical skeptical analysis.
            </p>
            <p class="font-mono-meta text-xs text-[var(--color-text-dim)]">
              DOMAIN: mynightlore.com // DEPLOY TARGET: Cloudflare Workers
            </p>
          </div>

          <!-- Column 2: Categories -->
          <div>
            <h4 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-4">Taxonomy</h4>
            <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
              {categories.slice(0, 4).map(cat => (
                <li>
                  <a href={`/category/${cat}`} class="hover:text-[var(--glow)] transition-colors">
                    {cat}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Column 3: Trust & Legal -->
          <div>
            <h4 class="font-mono-meta text-xs uppercase tracking-wider text-[var(--color-text-dim)] mb-4">Standards</h4>
            <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
              <li><a href="/about" class="hover:text-[var(--glow)] transition-colors">Editorial Sourcing Standards</a></li>
              <li><a href="/about#privacy" class="hover:text-[var(--glow)] transition-colors">Non-Public Person Privacy Policy</a></li>
              <li><a href="/submit" class="hover:text-[var(--glow)] transition-colors">Reader Case Submission</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-8 border-t border-[var(--color-border)] flex flex-col sm:flex-row items-center justify-between text-xs font-mono-meta text-[var(--color-text-dim)] gap-4">
          <p>© {new Date().getFullYear()} Night Lore. All rights reserved.</p>
          <p>Strictly non-fictional research & sourced archival documentation.</p>
        </div>
      </div>
    </footer>

    <!-- Global Audio Player -->
    <AudioPlayer />

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        menuBtn?.addEventListener('click', () => {
          menu?.classList.toggle('hidden');
        });
      });
    </script>
  </body>
</html>
